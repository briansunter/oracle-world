# OCI Free Tier — Environment Variables
# Loaded automatically by `just` recipes (via `set dotenv-load`).
#
# Quick setup (recommended):
#   ./generate-env.sh
#
# Manual setup:
#   cp .env.example .env
#   Do not copy a placeholder passphrase into a live environment. Prefer:
#   ./generate-env.sh --no-mysql

# State encryption passphrase (required, min 16 chars)
# Encrypts terraform state/plan files at rest so secrets aren't plaintext on disk.
TF_VAR_state_passphrase=""

# MySQL admin password (only needed when enable_mysql = true)
# 8-32 chars, must include uppercase, lowercase, number, special char.
# Generate with: openssl rand -base64 18 | head -c 20; echo '!A1'
# TF_VAR_mysql_admin_password=""
